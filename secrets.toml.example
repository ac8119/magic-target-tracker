# Template for Streamlit secrets.
# Local: save as target_tracker/.streamlit/secrets.toml (git-ignored).
# Cloud: paste into the app's Settings -> Secrets box.

[credentials]           # one line per person: username = "password"
ani = "pick-a-password"
guy = "another-password"
deepti = "another-password"

# OPTIONAL: workstation-only pages (Target explorer, Follow-up progress).
# Default-closed: a missing section or key HIDES the pages. Set this ONLY in
# the local secrets.toml on a machine holding the MAGIC catalogs — the cloud
# deploy must NOT set it (those pages expose unpublished target selections).
#
# [features]
# explorer = true

# OPTIONAL: durable queue storage in a Google Sheet (recommended for cloud
# deployment — the app's local disk is wiped whenever the app restarts).
# 1. console.cloud.google.com -> create a service account -> download JSON key
# 2. Enable the "Google Sheets API" for that project
# 3. Create an empty Google Sheet, share it (Editor) with the service account email
# 4. Fill in below; sheet_key is the long ID in the sheet's URL
#
# [gsheets]
# sheet_key = "1AbC..."
# [gsheets.service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"

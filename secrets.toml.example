# Template for Streamlit secrets.
# Local: save as target_tracker/.streamlit/secrets.toml (git-ignored).
# Cloud: paste into the app's Settings -> Secrets box.

[credentials]           # one line per person: username = "password"
ani = "pick-a-password"
guy = "another-password"
deepti = "another-password"

# OPTIONAL: explorer / follow-up pages (default-closed: a missing section or
# key HIDES them). Enable only on deployments that have catalogs on disk and
# are intended for explorer access; leave unset on the shared duplicate-
# checker deploy (the pages expose unpublished target selections).
#
# [features]
# explorer = true

# OPTIONAL: explorer catalog search paths (the filename is the version label).
# Precedence: these secrets > MAGIC_CATALOG_GLOBS env var > the local
# fallback paths in explorer.py. [catalogs.users] adds per-login globs,
# merged before the deployment-wide list. allowed_roots (optional,
# default-closed) reveals a session-scoped "add catalog path" input that
# accepts ONLY paths under these roots — never open roots you would not
# hand the logged-in users a file browser for.
# NOTE: first use of a catalog builds a Parquet cache in data/explorer_cache/
# next to the app — budget roughly 10% of each catalog's FITS size in disk.
#
# Worked example, collaborator deployment (their server, their catalogs):
#   [credentials]
#   guy = "their-password"
#   [features]
#   explorer = true
#   [catalogs]
#   globs = ["/data/magic/catalogs/*.fits"]
#   allowed_roots = ["/data/magic"]
#   [catalogs.users]
#   guy = ["/home/guy/magic_cats/*.fits"]

# OPTIONAL: durable queue storage in a Google Sheet (recommended for cloud
# deployment — the app's local disk is wiped whenever the app restarts).
# 1. console.cloud.google.com -> create a service account -> download JSON key
# 2. Enable the "Google Sheets API" for that project
# 3. Create an empty Google Sheet, share it (Editor) with the service account email
# 4. Fill in below; sheet_key is the long ID in the sheet's URL
#
# [gsheets]
# sheet_key = "1AbC..."
# [gsheets.service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
